rules_version = '2';
// ROLE_MATRIX + RULES-02: client gates in docs/ROLE_MATRIX.md — keep rules aligned with src/services write paths.
// businessId convention: when null/omitted, row is legacy user-scoped (userId == request.auth.uid).
// When set, row is tenant-scoped; reads use isMemberOf(businessId); writes use helpers below (owner vs staff).
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberOf(businessId) {
      return isAuthenticated()
        && businessId != null
        && exists(/databases/$(database)/documents/businessMembers/$(businessId)/members/$(request.auth.uid));
    }

    function memberRole(businessId) {
      return isMemberOf(businessId)
        ? get(/databases/$(database)/documents/businessMembers/$(businessId)/members/$(request.auth.uid)).data.role
        : null;
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.owner == request.auth.uid;
    }

    function canWriteBusinessChecklist(businessId) {
      return isBusinessOwner(businessId) || memberRole(businessId) == 'staff';
    }

    function canWriteBusinessOperations(businessId) {
      return isBusinessOwner(businessId) || memberRole(businessId) == 'staff';
    }
    
    // users (+ users/{uid}/preferences/**) — userProfile, pushNotifications, userPreferences; no businessId on user root doc
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User preferences subdocument (for reminders, digest time, etc.)
      match /preferences/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // businesses — userProfile default business, businessMembers context; tenant root (owner field)
    match /businesses/{businessId} {
      allow create: if isAuthenticated()
        && request.resource.data.owner == request.auth.uid;
      allow read: if isMemberOf(businessId) || resource.data.owner == request.auth.uid;
      allow update, delete: if isBusinessOwner(businessId);
    }

    // businessMembers/{bid}/members — businessMembers.js, userProfile; role used in rules helpers for businessId-scoped collections
    match /businessMembers/{businessId}/members/{memberUserId} {
      allow create: if isBusinessOwner(businessId)
        && request.resource.data.businessId == businessId;
      allow read: if isAuthenticated()
        && (
          request.auth.uid == memberUserId
          || isBusinessOwner(businessId)
        );
      allow update, delete: if isBusinessOwner(businessId);
    }

    // businessMembers/{bid}/inviteCodes — createInviteCode in businessMembers.js; owner-only writes
    match /businessMembers/{businessId}/inviteCodes/{inviteId} {
      allow read, delete: if isBusinessOwner(businessId);
      allow create, update: if isBusinessOwner(businessId)
        && request.resource.data.businessId == businessId;
    }
    
    // documents — dashboard.js, UploadDocumentModal (via firestore service), userProfile reads
    match /documents/{documentId} {
      // Legacy: businessId == null, self-service by userId (pre–default-business flows)
      allow read, delete: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.businessId == null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Business-scoped: members read; document create/update/delete owner-only (ROLE_MATRIX)
      allow read: if isAuthenticated()
        && resource.data.businessId != null
        && isMemberOf(resource.data.businessId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.businessId == null
          || (
            request.resource.data.businessId != null
            && isMemberOf(request.resource.data.businessId)
            && isBusinessOwner(request.resource.data.businessId)
          )
        );
      allow update, delete: if isAuthenticated()
        && resource.data.businessId != null
        && isBusinessOwner(resource.data.businessId);
    }
    
    // checklistItems — checklistInstanceSync, checklistScheduling, checklistItems.js, dashboard merge
    match /checklistItems/{itemId} {
      // Legacy: businessId == null
      allow read, delete: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.businessId == null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Business-scoped: members can read; owner + staff can write checklist items
      allow read: if isAuthenticated()
        && resource.data.businessId != null
        && isMemberOf(resource.data.businessId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.businessId == null
          || (
            request.resource.data.businessId != null
            && canWriteBusinessChecklist(request.resource.data.businessId)
          )
        );
      allow update, delete: if isAuthenticated()
        && resource.data.businessId != null
        && canWriteBusinessChecklist(resource.data.businessId);
    }
    
    // mediaLogs — mediaLogs.js (+ dashboard fetchMediaLogs)
    match /mediaLogs/{logId} {
      // Legacy: businessId == null
      allow read, delete: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.businessId == null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Business-scoped: members can read, owner can write
      allow read: if isAuthenticated()
        && resource.data.businessId != null
        && isMemberOf(resource.data.businessId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.businessId == null
          || (
            request.resource.data.businessId != null
            && isBusinessOwner(request.resource.data.businessId)
          )
        );
      allow update, delete: if isAuthenticated()
        && resource.data.businessId != null
        && isBusinessOwner(resource.data.businessId);
    }

    // incidents — incidents.js, dashboard listIncidents
    match /incidents/{incidentId} {
      // Legacy: businessId == null
      allow read, delete: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.businessId == null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Business-scoped: members can read; owner + staff can write
      allow read: if isAuthenticated()
        && resource.data.businessId != null
        && isMemberOf(resource.data.businessId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.businessId == null
          || (
            request.resource.data.businessId != null
            && canWriteBusinessOperations(request.resource.data.businessId)
          )
        );
      allow update, delete: if isAuthenticated()
        && resource.data.businessId != null
        && canWriteBusinessOperations(resource.data.businessId);
    }

    // maintenanceTasks — maintenanceTasks.js, dashboard listMaintenanceTasks
    match /maintenanceTasks/{taskId} {
      // Legacy: businessId == null
      allow read, delete: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.businessId == null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.businessId == null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Business-scoped: members can read; owner + staff can write
      allow read: if isAuthenticated()
        && resource.data.businessId != null
        && isMemberOf(resource.data.businessId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.businessId == null
          || (
            request.resource.data.businessId != null
            && canWriteBusinessOperations(request.resource.data.businessId)
          )
        );
      allow update, delete: if isAuthenticated()
        && resource.data.businessId != null
        && canWriteBusinessOperations(resource.data.businessId);
    }
    
    // checklistTemplates — read in app (e.g. checklist scheduling); client writes denied (seed via admin/backend)
    match /checklistTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if false; // Prevent client writes
    }

    // reportLinks — written/read only by Cloud Functions (Admin SDK). Deny all client access.
    match /reportLinks/{reportId} {
      allow read, write: if false;
    }
  }
}
