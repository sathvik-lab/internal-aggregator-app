rules_version = '2';
// Paths must match STORAGE_PATHS in src/constants/constants.js and uploads from src/services/* + UI.
// All rules below are auth-scoped (request.auth.uid); tightening = deny unexpected paths only.
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User documents — UploadDocumentModal / documentTypes use category subfolders under user_documents/*.
    // Example: user_documents/permits/{userId}/{fileName}
    match /user_documents/{category}/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId 
        && request.resource.size < 10485760 // 10MB max
        && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document)');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // user_profiles — EditProfileModal (STORAGE_PATHS.PROFILES); not in services/ but same bucket rules
    match /user_profiles/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5242880 // 5MB max for profile pics
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // checklist_photos — checklist UI uploads (STORAGE_PATHS.CHECKLIST_PHOTOS); image-only in app
    match /checklist_photos/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5242880 // 5MB max
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Incident + maintenance attachments — src/services/incidents.js and maintenanceTasks.js use
    // STORAGE_PATHS.INCIDENT_PHOTOS ('incident_photos') with {userId} segment; may upload image or video.
    match /incident_photos/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 20971520 // 20MB — same cap as media_logs for short video clips
        && request.resource.contentType.matches('(image/.*|video/.*)');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Certifications - users can only access their own certifications (reserved for future use)
    match /certifications/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 10485760 // 10MB max
        && request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Media logs — src/services/mediaLogs.js (STORAGE_PATHS.MEDIA_LOGS)
    match /media_logs/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 20971520 // 20MB max for photos/videos
        && request.resource.contentType.matches('(image/.*|video/.*)');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
